{
  "name": "daybook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:device": "DAYBOOK_DEVICE=1 next build",
    "build:windows": "DAYBOOK_DEVICE=windows next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm build:device && pnpm site:verify",
    "mcp": "node cli/daybook.mjs mcp",
    "site:dev": "pnpm --filter daybook-site dev",
    "site:verify": "pnpm --filter daybook-site typecheck && pnpm --filter daybook-site build"
  },
  "dependencies": {
    "@upstash/redis": "^1.39.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@10.34.5",
  "description": "A super simple, agent-friendly daily planner with a painting of the day. MCP for Claude, Cursor, Codex, ChatGPT and Grok; Linear and Frame Dashboard built in.",
  "license": "MIT",
  "repository": "github:joseamijares/daybook",
  "bin": {
    "daybook": "cli/daybook.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/joseamijares/daybook#readme",
  "bugs": "https://github.com/joseamijares/daybook/issues",
  "keywords": [
    "planner",
    "daily-planner",
    "sunsama",
    "mcp",
    "model-context-protocol",
    "nextjs",
    "linear",
    "productivity"
  ]
}
