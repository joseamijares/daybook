# Copy to .env.local for development; set the same names in Vercel for production.

# The one secret. Agents send it as "Authorization: Bearer <key>"; the browser asks for it once.
# Generate with: openssl rand -hex 24. Needed on Vercel for a cloud Daybook; without it (or without
# Upstash) the deploy only offers "on this device", with everything kept in each visitor's browser.
DAYBOOK_KEY=

# Time zone that decides "today" (IANA name), UI language (en | es), and a day's capacity in minutes.
DAYBOOK_TZ=UTC
DAYBOOK_LOCALE=en
DAYBOOK_CAPACITY_MINUTES=360

# Optional: encrypts the Linear and Frame keys you save in Settings. Defaults to DAYBOOK_KEY;
# set it if you plan to rotate DAYBOOK_KEY without reconnecting. openssl rand -hex 32
DAYBOOK_SECRET=

# Storage. Without these, data lives in .data/daybook.json (local only).
# Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead; either pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: the Redis key prefix (to share one database between Daybooks), and another path for the local file.
DAYBOOK_PREFIX=daybook
DAYBOOK_DATA_FILE=

# Linear and Frame Dashboard: connect them in Settings (/settings), or pin them here.
# Values here win over Settings. Linear: Settings → Security & access → Personal API keys.
LINEAR_API_KEY=

# Frame Dashboard (github.com/joseamijares/frame-dashboard): its URL and its DASHBOARD_WRITE_KEY.
FRAME_DASHBOARD_URL=
FRAME_DASHBOARD_WRITE_KEY=
# true = two-way sync with the Frame after every change (runs after the response).
FRAME_AUTO_SYNC=false

# Vercel Cron calls /api/cron/sync with this secret (see vercel.json). Generate with: openssl rand -hex 24
CRON_SECRET=

# Optional: the commit /api/health reports when not on Vercel (Vercel sets VERCEL_GIT_COMMIT_SHA).
GIT_SHA=
