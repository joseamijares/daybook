# Copy to .env.local for development; set the same names in Vercel for production.

# The one secret. Agents send it as "Authorization: Bearer <key>"; the browser asks for it once.
# Generate with: openssl rand -hex 24. Required on Vercel (the app refuses to run open there).
DAYBOOK_KEY=

# Time zone that decides "today" (IANA name), UI language (en | es), and a day's capacity in minutes.
DAYBOOK_TZ=America/Monterrey
DAYBOOK_LOCALE=en
DAYBOOK_CAPACITY_MINUTES=360

# Storage. Without these, data lives in .data/daybook.json (local only).
# Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead; either pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Linear: a personal API key (Linear → Settings → Security & access → Personal API keys).
LINEAR_API_KEY=

# Frame Dashboard (github.com/joseamijares/frame-dashboard): its URL and its DASHBOARD_WRITE_KEY.
FRAME_DASHBOARD_URL=
FRAME_DASHBOARD_WRITE_KEY=
# true = resend the week to the Frame after every change.
FRAME_AUTO_SYNC=false
