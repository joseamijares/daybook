# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# the Mac app's copy of the pages (mac/scripts/build-web.sh)
/.next-device/
# the Windows app's copy (pnpm build:windows)
/.next-windows/
/mac/DaybookPackage/Sources/DaybookFeature/Web/*
!/mac/DaybookPackage/Sources/DaybookFeature/Web/README.md

# production
/build

# misc
.DS_Store
*.pem
# signing material (Developer ID .p12, App Store Connect .p8)
*.p12
*.p8
AuthKey_*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.data/

# Logo explorations (AI-generated images, kept out of git)
brand/logo-proposals/
brand/logo-system-preview.png
.env*.local
