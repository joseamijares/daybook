# The landing page (site/). Copy to site/.env.local for development; set the same
# names on the site's own Vercel project for production. None of these are secrets.

# The page's public origin: canonical URLs, hreflang, the sitemap and llms.txt.
# On Vercel it falls back to the production domain.
NEXT_PUBLIC_SITE_URL=

# A public Daybook for "Open Daybook" (a deployment with no key works on each
# visitor's device). Without it the page leads with "Deploy your own".
NEXT_PUBLIC_APP_URL=

# The Mac app's disk image. Defaults to the latest GitHub release's Daybook.dmg
# (built by mac/scripts/package-dmg.sh).
NEXT_PUBLIC_MAC_DOWNLOAD_URL=

# Google Analytics 4 and Microsoft Clarity. Both are optional; with neither set,
# nothing loads and no consent banner shows.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
