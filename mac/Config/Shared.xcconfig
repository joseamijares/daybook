// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = Daybook
PRODUCT_DISPLAY_NAME = Daybook
PRODUCT_BUNDLE_IDENTIFIER = dev.daybook.mac
MARKETING_VERSION = 0.2.0
CURRENT_PROJECT_VERSION = 11

// ==========================================
// Platform Configuration
// ==========================================
MACOSX_DEPLOYMENT_TARGET = 14.0

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = YES

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/Daybook.entitlements to add capabilities
CODE_SIGN_ENTITLEMENTS = Config/Daybook.entitlements
// ==========================================
// Daybook
// ==========================================
// Generated keys plus Config/Info.plist (App Transport Security for localhost).
INFOPLIST_FILE = Config/Info.plist
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.productivity
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
INFOPLIST_KEY_NSHumanReadableCopyright = MIT License
SWIFT_VERSION = 6.0
// Sparkle.framework (updates) is embedded in Contents/Frameworks; the app has to look there.
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
