{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daybook",
  "version": "0.1.0",
  "identifier": "dev.daybook.windows",
  "build": {
    "frontendDist": "../.next-windows"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Jamak",
    "category": "Productivity",
    "shortDescription": "A daily planner with a painting of the day.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
